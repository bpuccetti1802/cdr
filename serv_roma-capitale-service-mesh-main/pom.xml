<!--					<centralAnalyzerEnabled>false</centralAnalyzerEnabled>-->
<!--					<versionCheckEnabled>true</versionCheckEnabled>-->
<!--&lt;!&ndash;					<nvdApiKey></nvdApiKey>&ndash;&gt;-->
<!--&lt;!&ndash;					<nvdApiDelay>6000</nvdApiDelay> &lt;!&ndash; Tempo in millisecondi &ndash;&gt;&ndash;&gt;-->
<!--				</configuration>-->
<!--			</plugin>-->
			<plugin>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>${maven-deploy-plugin.version}</version>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
